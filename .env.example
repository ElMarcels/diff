# --- Database (Vercel Postgres via Neon, or any Postgres-compatible URL) ---
DATABASE_URL=

# --- Platform owner bootstrap ---
# The account registered with this email is automatically a platform moderator
# and the only one with access to /owner (adds new mods, publishes approved
# submissions, manages roles). Default: hola@elmarcels.xyz
OWNER_EMAIL=hola@elmarcels.xyz
# Only needed by `npm run db:owner` to create the account from the CLI.
OWNER_PASSWORD=
OWNER_USERNAME=

# --- Public config (safe to expose to the client) ---
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite
NEXT_PUBLIC_SITE_URL=http://localhost:3000
