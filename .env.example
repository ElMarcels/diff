# --- Database (Vercel Postgres via Neon, or any Postgres-compatible URL) ---
DATABASE_URL=

# --- Discord OAuth ---
# Create an app at https://discord.com/developers/applications
# Redirect URI: <your-domain>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Auth.js / NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Public config (safe to expose to the client) ---
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite
NEXT_PUBLIC_SITE_URL=http://localhost:3000
